# Copy this file to `.env` (gitignored) and fill it in. NEVER commit a real token.
#
# FIGMA_TOKEN: Figma -> Settings -> Security -> Personal access tokens.
#   Scope needed: "File content: read" (file_content:read). Tokens expire after <= 90 days.
# FIGMA_FILE_KEY: the part of YOUR duplicated file's URL after /design/
#   e.g. https://www.figma.com/design/<THIS_PART>/Simple-Design-System
FIGMA_TOKEN=
FIGMA_FILE_KEY=