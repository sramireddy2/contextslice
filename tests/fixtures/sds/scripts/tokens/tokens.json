{
  "@color_primitives": {
    "brand": {
      "500": {
        "$type": "color",
        "$value": "#2c2c2c",
        "$extensions": {
          "com.figma.sds": { "figmaId": "VariableID:1:11", "modes": { "default": "#2c2c2c" } }
        }
      }
    }
  },
  "@color": {
    "background": {
      "brand": {
        "$type": "color",
        "$value": "{@color_primitives.Brand.500}",
        "$extensions": {
          "com.figma.sds": {
            "figmaId": "VariableID:1:10",
            "modes": {
              "light": "{@color_primitives.Brand.500}",
              "dark": "#ffffff",
              "brand_b": "{@color_primitives.Brand B.500}"
            }
          }
        }
      }
    }
  },
  "@size": {
    "space": {
      "200": {
        "$type": "number",
        "$value": 8,
        "$extensions": {
          "com.figma.sds": { "figmaId": "VariableID:1:20", "modes": { "default": 8 } }
        }
      },
      "unused": {
        "$type": "number",
        "$value": 64,
        "$extensions": {
          "com.figma.sds": { "figmaId": "VariableID:1:21", "modes": { "default": 64 } }
        }
      }
    }
  }
}
